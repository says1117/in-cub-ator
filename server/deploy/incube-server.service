# server/deploy/incube-server.service: systemd unit that runs the server on the Jetson. Owner: Role 2 (server).
# setup_jetson.sh fills in @REPO@ and @USER@ and installs it to /etc/systemd/system/.
[Unit]
Description=In-cube-ator game server
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@/server
EnvironmentFile=-@REPO@/server/deploy/server.env
ExecStart=@REPO@/server/.venv/bin/python -m app.main
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
