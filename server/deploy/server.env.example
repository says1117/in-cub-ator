# server/deploy/server.env.example: Copy to server.env to override settings (read by the systemd unit). Owner: Role 2 (server).
# INCUBE_MQTT_HOST=localhost
# INCUBE_VISION=1          # use the camera for the sunlight meter
# INCUBE_CAMERA=csi        # csi = ribbon-cable camera, 0 = first USB camera
# INCUBE_AUTO_LIGHT=1      # turn the grow light on when it is dark
# INCUBE_PUMP_MS=3000
